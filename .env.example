# Environment Variables Template
# Copy this file to .env.local and fill in your values

# Site Configuration
SITE_URL=https://smsindia.vercel.app
SITE_NAME=SMSIndia Blog
SITE_DESCRIPTION=Your source for SMS, telecom, and technology trends in India

# Google AdSense (Optional - Add your publisher ID when ready)
# NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# Content API (if using external CMS in future)
# CMS_API_KEY=your_api_key_here
