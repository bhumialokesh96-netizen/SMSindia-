# Environment Variables Configuration
# Copy this file to .env.local and fill in your values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://smsindia-blog.vercel.app

# Google Services
# Get your AdSense Publisher ID from https://www.google.com/adsense
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# Get Google Verification code from Google Search Console
NEXT_PUBLIC_GOOGLE_VERIFICATION=your-google-verification-code

# Analytics (Optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# API Keys (Optional - for trending content pipeline)
# GOOGLE_TRENDS_API_KEY=your-api-key
# NEWS_API_KEY=your-api-key
